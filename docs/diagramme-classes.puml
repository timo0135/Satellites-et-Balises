@startuml diagramme-classes
title Satellites et balises - diagramme de classes
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

' Monde 2D vue de cote : longitude = axe horizontal,
' altitude = axe vertical (0 surface, < 0 sous l'eau, > 0 satellites).

' =====================================================
' MODELE : le monde simule (src/model)
' =====================================================
package "model" {

  class Simulation {
    - tempsCourant : int
    + tick()
    + ajouter(e : Entite)
    + supprimer(id : String)
    + ajouterObservateur(o : Observateur)
    + ajouterTransfert(t : Transfert)
    + retirerTransfert(t : Transfert)
    + getBalises() : List<Balise>
    + getSatellites() : List<Satellite>
    + exporterEtat() : EtatSimulation
    + restaurer(e : EtatSimulation)
  }

  class Position {
    - longitude : double
    - altitude : double
    + copie() : Position
    + distanceHorizontale(p : Position) : double
  }

  abstract class Entite {
    - id : String
    - position : Position
    + {abstract} mettreAJour(s : Simulation)
  }

  package "satellite" {
    class Satellite {
      - disponible : boolean
      - donneesRecues : List<Mesure>
      + estDisponible() : boolean
      + setDisponible(d : boolean)
      + recevoir(m : List<Mesure>)
      + mettreAJour(s : Simulation)
    }

    ' --- Strategy : orbites des satellites
    interface Orbite {
      + avancer(s : Satellite)
    }
    class OrbiteCirculaire {
      - circonference : double
      - vitesse : double
    }
    class Geostationnaire
  }

  package "balise" {
    class Balise {
      + equiper(i : Instrument)
      + desequiper(i : Instrument)
      + changerDeplacement(d : Deplacement)
      + changerActivite(a : Activite)
      + creerContexte() : Contexte
      + enAttenteDeTransmission() : boolean
      + mettreAJour(s : Simulation)
    }

    class Memoire {
      - capacite : int
      + ajouter(m : Mesure)
      + estPleine() : boolean
      + estVide() : boolean
      + vider() : List<Mesure>
    }
  }

  package "deplacement" {
    ' --- Strategy : deplacements des balises
    interface Deplacement {
      + deplacer(b : Balise)
    }
    class Horizontal
    class Vertical
    class Sinusoidal
    class Immobile
    class ProfondeurFixe
  }

  package "activite" {
    ' --- State : activites des balises
    interface Activite {
      + agir(b : Balise)
      + suivante(b : Balise) : Activite
    }
    class Collecte
    class Remontee
    class Transmission
  }

  package "instrument" {
    ' --- Instruments (points d'extension)
    interface Instrument {
      + mesurer(c : Contexte) : Mesure
    }
    class Contexte {
      - position : Position
      - instant : double
    }
    class Thermometre
    class Salinometre
    class Courantometre
    class CapteurTurbidite
  }

  package "mesure" {
    abstract class Mesure {
      - instant : double
      - lieu : Position
    }
    class MesureTemperature
    class MesureSalinite
    class MesureCourant
    class MesureTurbidite
  }

  package "communication" {
    class Transfert {
      - etat : EtatTransfert
      - progression : int
      + avancer()
      + interrompre()
    }

    enum EtatTransfert {
      EN_ATTENTE
      EN_COURS
      TERMINE
    }

    class GestionnaireCommunication {
      - portee : double
      + detecter(s : Simulation)
      + peutCommuniquer(b : Balise, s : Satellite) : boolean
    }
  }
}

' --- relations du modele
Simulation o-- "*" Entite
Simulation *-- "*" Transfert
Simulation --> GestionnaireCommunication
GestionnaireCommunication ..> Transfert : cree
Entite *-- Position
Entite <|-- Satellite
Entite <|-- Balise
Satellite --> "1" Orbite
Satellite o-- "*" Mesure : donneesRecues
Orbite <|.. OrbiteCirculaire
Orbite <|.. Geostationnaire
Balise --> "1" Deplacement : strategie
Balise --> "1" Activite : etat courant
Balise o-- "*" Instrument
Balise *-- "1" Memoire
Memoire o-- "*" Mesure
Deplacement <|.. Horizontal
Deplacement <|.. Vertical
Deplacement <|.. Sinusoidal
Deplacement <|.. Immobile
Deplacement <|.. ProfondeurFixe
Activite <|.. Collecte
Activite <|.. Remontee
Activite <|.. Transmission
Collecte ..> Remontee : suivante (memoire pleine)
Remontee ..> Transmission : suivante (en surface)
Transmission ..> Collecte : suivante (memoire videe)
Instrument <|.. Thermometre
Instrument <|.. Salinometre
Instrument <|.. Courantometre
Instrument <|.. CapteurTurbidite
Instrument ..> Contexte : lit
Instrument ..> Mesure : produit
Mesure <|-- MesureTemperature
Mesure <|-- MesureSalinite
Mesure <|-- MesureCourant
Mesure <|-- MesureTurbidite
Transfert --> "1" Balise
Transfert --> "1" Satellite
Transfert --> EtatTransfert

' =====================================================
' VUE : Observer (src/vue) - Observateur seul pour l'instant
' =====================================================
package "vue" {
  interface Observateur {
    + miseAJour(s : Simulation)
  }
  class VueSimulation {
    + dessiner()
  }
  interface Representation {
    + dessiner(e : Entite)
  }
  class RepresentationBalise
  class RepresentationSatellite
}

Simulation o-- "*" Observateur
Observateur <|.. VueSimulation
VueSimulation --> "*" Representation
Representation <|.. RepresentationBalise
Representation <|.. RepresentationSatellite

' =====================================================
' LANGAGE : Composite + Visitor + Factory (a venir)
' =====================================================
package "langage" {
  class Programme {
    - instructions : List<Instruction>
  }
  interface Instruction {
    + accepter(v : Visiteur)
  }
  class Creer
  class Supprimer
  class Configurer
  class Equiper
  class ChangerComportement
  class Personnaliser

  interface Visiteur {
    + visiter(c : Creer)
    + visiter(s : Supprimer)
    + visiter(c : Configurer)
    + visiter(e : Equiper)
    + visiter(c : ChangerComportement)
    + visiter(p : Personnaliser)
  }
  class Interpreteur {
    - simulation : Simulation
  }
  class Registre {
    + enregistrer(nom : String, f : Fabrique)
    + creer(nom : String) : Object
  }
}

Programme *-- "*" Instruction
Instruction <|.. Creer
Instruction <|.. Supprimer
Instruction <|.. Configurer
Instruction <|.. Equiper
Instruction <|.. ChangerComportement
Instruction <|.. Personnaliser
Instruction ..> Visiteur : accepte
Visiteur <|.. Interpreteur
Interpreteur --> Simulation : pilote
Interpreteur --> Registre : fabrique

' =====================================================
' PERSISTANCE : Memento (a venir)
' =====================================================
package "persistance" {
  class EtatSimulation <<memento>> {
    - tempsCourant : int
    - etatsEntites : List
    - etatsTransferts : List
  }
  class Sauvegarde {
    + ecrire(e : EtatSimulation, f : Fichier)
    + lire(f : Fichier) : EtatSimulation
  }
}

Simulation ..> EtatSimulation : produit / restaure
Sauvegarde ..> EtatSimulation
Sauvegarde ..> Registre : reconstruit via

note bottom of vue
  Pas encore codes : VueSimulation, Representation*,
  le package langage et le package persistance.
  Simulation.exporterEtat() / restaurer() non plus.
end note

@enduml
