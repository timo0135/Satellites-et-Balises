@startuml diagramme-classes-v1

title Satellites et balises - V1 : le modele
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
hide empty members

' Monde 2D vue de cote : longitude = axe horizontal (circulaire),
' altitude = axe vertical (0 surface, < 0 sous l'eau, > 0 satellites).
' Voir aussi : diagramme-evenements-v1.puml et diagramme-vue-v1.puml

class Simulation {
  - tempsCourant : int
  + tick()
  + ajouter(e : Entite)
  + supprimer(id : String)
  + getEntites() : Collection<Entite>
}

abstract class Entite {
  - id : String
  + {abstract} mettreAJour(s : Simulation)
}

class Position {
  - longitude : double
  - altitude : double
}

' --- Satellites : Strategy sur l'orbite
class Satellite {
  - orbite : Orbite
}
interface Orbite {
  + avancer(s : Satellite)
}
class OrbiteCirculaire
class Geostationnaire

' --- Balises : Strategy sur le deplacement
class Balise {
  - deplacementActuel : Deplacement
  + changerDeplacement(d : Deplacement)
}
interface Deplacement {
  + deplacer(b : Balise)
}
class Horizontal
class Vertical
class Sinusoidal
class ProfondeurFixe
class Immobile

Simulation o-- "*" Entite
Entite *-- "1" Position
Entite <|-- Satellite
Entite <|-- Balise

Satellite --> "1" Orbite
Orbite <|.. OrbiteCirculaire
Orbite <|.. Geostationnaire

Balise --> "1" Deplacement
Deplacement <|.. Horizontal
Deplacement <|.. Vertical
Deplacement <|.. Sinusoidal
Deplacement <|.. ProfondeurFixe
Deplacement <|.. Immobile

note bottom of Orbite
  Strategy : un satellite delegue son mouvement a son orbite.
end note

note bottom of Deplacement
  Strategy : une balise delegue son mouvement,
  on peut en changer a tout moment.
end note

@enduml
